{
  "version": 2,
  "video": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "monitor": 0,
    "capture_backend": "dxcam",
    "show_cursor": true,
    "cursor_highlight": false
  },
  "ui": {
    "preview_fps": 15,
    "toasts": true,
    "minimize_to_tray": true,
    "dnd_reminder": true,
    "advanced": true
  },
  "camera": {
    "enabled": true,
    "device": 0,
    "mirror": false,
    "corner": "bottom-right",
    "size": 0.25,
    "margin": 24,
    "position": null,
    "blur": false
  },
  "scenes": [
    {
      "name": "Ekran + kamera",
      "screen": true,
      "camera": "corner"
    },
    {
      "name": "Sadece ekran",
      "screen": true
    },
    {
      "name": "Sadece kamera",
      "camera": "full"
    },
    {
      "name": "Bekleme ekranı",
      "standby": true
    }
  ],
  "transition_ms": 300,
  "standby_text": "Birazdan döneceğim",
  "standby_image": "",
  "audio": {
    "mic_device": "",
    "mic_gain": 0.8,
    "mic_muted": false,
    "system_gain": 0.8,
    "system_muted": false,
    "system_mode": "auto",
    "exclude_apps": [
      "Zoom.exe",
      "Discord.exe",
      "ms-teams.exe",
      "Teams.exe",
      "Skype.exe"
    ],
    "include_app": "",
    "ducking": false,
    "ducking_level": 0.3,
    "ptt": false,
    "noise_suppression": false,
    "modes": {
      "sesim": [
        100,
        45
      ],
      "dengeli": [
        80,
        80
      ],
      "oyun": [
        70,
        100
      ]
    },
    "last_mode": "dengeli"
  },
  "pen": {
    "clear_on_close": true
  },
  "record": {
    "folder": "",
    "encoder": "auto",
    "replay": true,
    "replay_seconds": 15
  },
  "screenshot": {
    "folder": ""
  },
